# GitHub OAuth (required for private repositories and authenticated identity)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=

# Preferred Codex product integration: a server-side Codex app-server gateway.
CODEX_APP_SERVER_URL=
CODEX_APP_SERVER_TOKEN=

# Alternative managed API credential. Never expose this with NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Persistent application database used for users, cities, missions, events and permits.
DATABASE_URL=
